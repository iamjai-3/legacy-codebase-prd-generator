# LLM Provider Selection
# Options: openai, anthropic
LLM_PROVIDER=openai

# Embedding Provider Selection
# Options: openai (Anthropic doesn't provide embeddings, use OpenAI)
EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=prd_agent

# Temporal Configuration
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=prd-agent-queue

# Minio Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=screenshots
MINIO_SECURE=false

# Atlassian/Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=

# Confluence Configuration
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Cache Configuration (uses Temporal PostgreSQL)
CACHE_ENABLED=true
CACHE_HOST=localhost
CACHE_PORT=5432
CACHE_DATABASE=temporal
CACHE_USER=temporal
CACHE_PASSWORD=temporal
CACHE_LLM_RESPONSE_TTL=86400
CACHE_VECTOR_SEARCH_TTL=3600
CACHE_TOOL_RESULT_TTL=1800

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIES=3

